# Innkeeper local environment. Copy to `.env` and adjust. NEVER commit real credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=innkeeper
PGDATABASE_TEST=innkeeper_test

# Migration / DDL role (owns the schema; runs db:migrate and db:seed)
PGUSER_OWNER=innkeeper_owner
PGPASSWORD_OWNER=innkeeper_owner_pass

# Runtime request-path role (NOBYPASSRLS, not the table owner)
PGUSER_APP=innkeeper_app
PGPASSWORD_APP=innkeeper_app_pass

# Outbox/background worker role (BYPASSRLS; never used in request paths)
PGUSER_WORKER=innkeeper_worker
PGPASSWORD_WORKER=innkeeper_worker_pass

# Read-only analytics role (NOBYPASSRLS)
PGUSER_READONLY=innkeeper_readonly
PGPASSWORD_READONLY=innkeeper_ro_pass

PORT=3000
